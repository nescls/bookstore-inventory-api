DATABASE_URL=postgres://bookstore:bookstore@localhost:55432/bookstore
PORT=3000
NODE_ENV=development
EXCHANGE_RATE_URL=https://api.exchangerate-api.com/v4/latest/USD
EXCHANGE_RATE_TIMEOUT_MS=5000
# trace | debug | info | warn | error | fatal | silent (default info).
LOG_LEVEL=info
# Local logger: records go to stdout and <LOG_DIR>/app.log (default ./logs).
LOG_DIR=logs
# Detached logger: set a log name to send records to Google Cloud Logging instead.
# Credentials come from GOOGLE_APPLICATION_CREDENTIALS / GOOGLE_CLOUD_PROJECT.
GOOGLE_CLOUD_LOG_NAME=
# Optional positive USD-to-EUR rate for offline seed initialization only.
SEED_EXCHANGE_RATE=
TEST_DATABASE_URL=postgres://bookstore:bookstore@localhost:55433/bookstore_test
